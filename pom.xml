        <dependency>
            <groupId>com.github.valfirst.browserup-proxy</groupId>
            <artifactId>browserup-proxy-core</artifactId>
            <version>3.3.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
